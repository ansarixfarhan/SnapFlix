{
  "name": "snapflix",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "next start --hostname 0.0.0.0",
