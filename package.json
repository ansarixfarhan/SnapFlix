    "typescript": "^5.9.3",
    "webpack": "^5.101.2",
    "wrangler": "^4.156.0"
  },
  "prettier": {
    "proseWrap": "never",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
