    "@mantine/hooks": "^8.3.18",
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
