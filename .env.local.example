# Server environment variables
PROTECTED_PATHS="/auth/reset-password,/profile" #OPTIONAL, comma separated list of protected paths
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key #REQUIRED

# TMDB (The Movie Database) - read access token, not the api key
# Website catalog lists use the credential chain below. The separate mobile
# metadata API (/api/mobile/v1/*) is stricter: it requires TMDB_ACCESS_TOKEN
# and never uses NEXT_PUBLIC_TMDB_ACCESS_TOKEN, TMDB_API_KEY or the mirror.
TMDB_ACCESS_TOKEN="your_tmdb_access_token" #OPTIONAL for website, REQUIRED for mobile API, server only
TMDB_API_KEY="your_tmdb_api_key" #OPTIONAL, website v3 key fallback only
MOBILE_API_KEY="your_optional_mobile_app_key" #OPTIONAL; when set, app must send X-SnapFlix-Mobile-Key

# Client environment variables
NEXT_PUBLIC_TMDB_ACCESS_TOKEN="your_tmdb_access_token" #REQUIRED unless TMDB_ACCESS_TOKEN is set, not the api key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url #REQUIRED
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key #REQUIRED
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_captcha_site_key #OPTIONAL, if you want to use captcha
NEXT_PUBLIC_AVATAR_PROVIDER_URL=your_avatar_provider_url #OPTIONAL, avatar for your users
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id" #OPTIONAL, Google OAuth Client ID

NEXT_PUBLIC_BACKEND_URL="https://api.snapflix.indevs.in"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="atlIepm5DvSugRHSudy3EebPGch2CztkA_0MghNMTHY"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-5E6KQ2LRZ3"
